import Openmath.Proofs.MatchingJoinDefs

/-! # Explicit positive half-path certificates for every admitted terminal state -/

open SimpleGraph Finset
namespace Erdos585.MatchingJoin

set_option maxRecDepth 65536
set_option maxHeartbeats 64000000

def TwoPaths {V : Type*} [DecidableEq V] (G : SimpleGraph V) (a b c d : V) : Prop :=
  ∃ r : G.Walk a b, ∃ t : G.Walk c d,
    r.IsPath ∧ t.IsPath ∧ r.support.toFinset = t.support.toFinset ∧
      Disjoint r.edges.toFinset t.edges.toFinset

def orderEdges {V : Type*} (l : List V) : List (Sym2 V) :=
  l.zipWith (fun x y => s(x,y)) l.tail

theorem walk_edges_eq_orderEdges {V : Type*} {G : SimpleGraph V} {a b : V}
    (p : G.Walk a b) : p.edges = orderEdges p.support := by
  induction p with
  | nil => rfl
  | @cons u v w h p ih =>
    cases p with
    | nil => rfl
    | cons h' p =>
      change s(u,v) :: (Walk.cons h' p).edges =
        s(u,v) :: orderEdges (Walk.cons h' p).support
      exact congrArg (List.cons s(u,v)) ih

def fromOrder {V : Type*} {G : SimpleGraph V} (a b : V) :
    (l : List V) → (a :: (l ++ [b])).IsChain G.Adj → G.Walk a b
  | [], h => .cons h.rel .nil
  | x :: l, h => .cons h.rel (fromOrder x b l h.of_cons)

@[simp] theorem support_fromOrder {V : Type*} {G : SimpleGraph V} (a b : V) (l : List V)
    (h : (a :: (l ++ [b])).IsChain G.Adj) :
    (fromOrder a b l h).support = a :: (l ++ [b]) := by
  induction l generalizing a with
  | nil => rfl
  | cons x l ih => simp only [fromOrder, Walk.support_cons, ih, List.cons_append]

