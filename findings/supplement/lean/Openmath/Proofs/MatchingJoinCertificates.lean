    [1,6,4,5,7,2,3,0,9,12,14,11,15],
    [1,7,4,5,6,2,3,0,9,12,15,13,14,10],
    [1,7,3,6,2,5,4,0,9,11,15,10,13,14],
    [1,7,3,6,2,5,4,0,10,11,15,9,12,14],
    [1,4,6,3,7,2,5,0,9,11,10,15,13]] i


def redOrder (i : Fin 114) : List (Fin 16) :=
  2 :: (redMiddle i ++ [(terminals i).1])
def blueOrder (i : Fin 114) : List (Fin 16) :=
  8 :: (blueMiddle i ++ [(terminals i).2])

/-- Every finite input is checked against the actual old half adjacency. -/
theorem certificate_valid (i : Fin 114) :
    (redOrder i).Nodup ∧ (blueOrder i).Nodup ∧
    (redOrder i).IsChain RegularFive.half.Adj ∧
    (blueOrder i).IsChain RegularFive.half.Adj ∧
    (redOrder i).toFinset = (blueOrder i).toFinset ∧
    Disjoint (orderEdges (redOrder i)).toFinset (orderEdges (blueOrder i)).toFinset := by
  have hall : ∀ i : Fin 114,
      (redOrder i).Nodup ∧ (blueOrder i).Nodup ∧
      (redOrder i).IsChain RegularFive.half.Adj ∧
      (blueOrder i).IsChain RegularFive.half.Adj ∧
      (redOrder i).toFinset = (blueOrder i).toFinset ∧
      Disjoint (orderEdges (redOrder i)).toFinset (orderEdges (blueOrder i)).toFinset := by
    decide
  exact hall i

theorem certificate_twoPaths (i : Fin 114) :
    TwoPaths RegularFive.half 2 (terminals i).1 8 (terminals i).2 := by
  obtain ⟨hr, hb, hrc, hbc, hs, he⟩ := certificate_valid i
  let r := fromOrder 2 (terminals i).1 (redMiddle i) hrc
  let b := fromOrder 8 (terminals i).2 (blueMiddle i) hbc
  have hrs : r.support = redOrder i := support_fromOrder 2 (terminals i).1 (redMiddle i) hrc
  have hbs : b.support = blueOrder i := support_fromOrder 8 (terminals i).2 (blueMiddle i) hbc
  refine ⟨r,b,?_,?_,?_,?_⟩
  · apply Walk.IsPath.mk'
    rw [hrs]
    exact hr
  · apply Walk.IsPath.mk'
    rw [hbs]
    exact hb
  · rw [hrs,hbs]
    exact hs
  · rw [walk_edges_eq_orderEdges,walk_edges_eq_orderEdges,hrs,hbs]
    exact he

/-- All 114 admitted ordered states, not just representatives, have actual paths. -/
theorem half_twoPaths (x y : Fin 16) (h : Admitted x y) :
    TwoPaths RegularFive.half 2 x 8 y := by
  have hc : ∀ x y : Fin 16, Admitted x y → ∃ i : Fin 114, terminals i = (x,y) := by
    decide
  obtain ⟨i,hi⟩ := hc x y h
  simpa [hi] using certificate_twoPaths i

end Erdos585.MatchingJoin
